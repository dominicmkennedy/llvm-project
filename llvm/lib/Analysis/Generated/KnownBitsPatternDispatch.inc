static PatternOp classifyKBValuePatternOp(const Value *V,
                                     const InstrInfoQuery &IIQ) {
  const auto *O = dyn_cast<Operator>(V);
  if (!O)
    return PatternOp::Other;
  return classifyPatternOp(O, IIQ);
}

static void computePatternKBMatches(const Operator *I, const SimplifyQuery &Q, unsigned Depth,
                                    SmallVectorImpl<PatternMatchKB> &Matches) {
  switch (classifyPatternOp(I, Q.IIQ)) {
  case PatternOp::Abs:
    if (auto M = matchAbs_AddNswNuw_arg0_arg1(I, Q, Depth + 1))
      Matches.push_back(std::move(*M));
    if (auto M = matchAbs_AddNsw_arg0_arg1(I, Q, Depth + 1))
      Matches.push_back(std::move(*M));
    break;
  case PatternOp::AbsUndef:
    {
      PatternOp Op0 = classifyKBValuePatternOp(I->getOperand(0), Q.IIQ);
      if (Op0 == PatternOp::AddNsw) {
        if (auto M = matchAbsUndef_AddNsw_SubNsw_arg0_ShlNswNuw_arg1_arg2_arg3(I, Q, Depth + 1))
          Matches.push_back(std::move(*M));
        if (auto M = matchAbsUndef_AddNsw_SubNsw_arg0_arg1_arg2(I, Q, Depth + 1))
          Matches.push_back(std::move(*M));
        if (auto M = matchAbsUndef_AddNsw_arg0_arg1(I, Q, Depth + 1))
          Matches.push_back(std::move(*M));
