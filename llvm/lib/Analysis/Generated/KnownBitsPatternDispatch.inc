        if (auto M = matchAbsUndef_Ashr_Shl_arg0_arg1_arg2(I, Q, Depth + 1))
          Matches.push_back(std::move(*M));
        if (auto M = matchAbsUndef_Ashr_arg0_arg1(I, Q, Depth + 1))
          Matches.push_back(std::move(*M));
