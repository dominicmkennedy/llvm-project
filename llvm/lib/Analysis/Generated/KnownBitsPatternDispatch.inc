        if (auto M = matchAbsUndef_AshrExact_arg0_arg1(I, Q, Depth + 1))
          Matches.push_back(std::move(*M));
      }

      if (Op0 == PatternOp::Mods) {
        if (auto M = matchAbsUndef_Mods_arg0_arg1(I, Q, Depth + 1))
