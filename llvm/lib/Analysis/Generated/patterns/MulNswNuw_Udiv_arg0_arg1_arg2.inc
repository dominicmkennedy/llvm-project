};
} // namespace

std::array<APInt, 2> solution(unsigned bw, std::array<APInt, 2> ssa_0, std::array<APInt, 2> ssa_1, std::array<APInt, 2> ssa_2) {
  const std::array<APInt, 2> args[3] = {ssa_0, ssa_1, ssa_2};
  return ::KnownBitsPatterns::lookupKB<3>(bw, args, kTables, std::size(kTables));
}
